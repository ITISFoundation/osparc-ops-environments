{{- $alertsPathPrefix := "/alerts" }}
{{- $datasourceProxyName := "vmalert-datasource-proxy" }}
{{- $datasourceProxyPort := 8427 }} # vmauth HTTP service

{{- $logsPort := .Values.sharedOps.victoriaLogs.httpPort }}
{{- $logsNamespace := .Values.sharedOps.victoriaLogs.namespace }}
{{- $logsService := .Values.sharedOps.victoriaLogs.serviceName }}

{{- $metricsVMAuthPort := .Values.sharedOps.victoriaMetrics.vmAuthHttpPort | int }}
{{- $metricsNamespace := .Values.sharedOps.victoriaMetrics.namespace }}
{{- $metricsService := .Values.sharedOps.victoriaMetrics.vmauthServiceName }}

{{- $metricsVMAuthURL := printf "http://%s.%s.svc.cluster.local.:%d/%s" $metricsService $metricsNamespace $metricsVMAuthPort "metrics" }}
{{- $logsURL := printf "http://%s.%s.svc.cluster.local.:%d/logs/" $logsService $logsNamespace $logsPort }}

vmK8sStackVMAuthPort: {{ $metricsVMAuthPort }}
victoriaLogsPort: {{ $logsPort }}
kubernetesApiServerPort: {{ requiredEnv "KUBERNETES_API_SERVER_PORT" }}
victoriaMetricsK8sStackNamespace: {{ $metricsNamespace | quote }}

configReloaderPort: 8435 # hardcoded in victoria metrics operator

vmauth:
  # necessary to support alerts based on logs and metrics at the same time
  # since vmalert support only one datasource, we need a proxy that later
  # routes to multiple backends
  # https://docs.victoriametrics.com/victorialogs/vmalert/#how-to-use-one-vmalert-for-victorialogs-and-victoriametrics-rules-at-the-same-time
  name: {{ $datasourceProxyName }}
  upstreamVMAuthPort: {{ $metricsVMAuthPort }}
  spec:
    port: {{ $datasourceProxyPort | quote }}
    logLevel: {{ requiredEnv "VICTORIA_METRICS_LOG_LEVEL" }}
    useStrictSecurity: true
    podMetadata:
      labels:
        app.simcore.io/name: vmauth-vmalert-datasource-proxy
        app.simcore.io/part-of: victoria-metrics-alert
    nodeSelector:
      node-role.kubernetes.io/ops: ""
    resources:
      requests:
        cpu: 10m
        memory: 64Mi
      limits:
        cpu: 200m
        memory: 128Mi
    configReloaderResources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 64Mi
    unauthorizedUserAccessSpec:
      discover_backend_ips: true
      url_map:
        # vmalert sends Prometheus query API requests to its single datasource URL.
        - src_paths:
            - "/api/v1/query.*"
          url_prefix:
            - {{ printf "%s/select/prometheus/" $metricsVMAuthURL | quote }}
        # VictoriaLogs query APIs are routed to its server, preserving its /logs prefix.
        - src_paths:
            - "/select/logsql/.*"
          url_prefix:
            - {{ $logsURL | quote }}

vmalert:
  name: victoria-metrics-alert
  spec:
    datasource:
      url: {{ printf "http://vmauth-%s:%d/" $datasourceProxyName $datasourceProxyPort }}
    remoteRead:
      url: {{ printf "%s/select/prometheus" $metricsVMAuthURL }}
    remoteWrite:
      url: {{ printf "%s/insert/prometheus" $metricsVMAuthURL }}
    evaluationInterval: 30s
    logLevel: {{ requiredEnv "VICTORIA_METRICS_LOG_LEVEL" }}
    port: "8080"
    selectAllByDefault: true
    useStrictSecurity: true
    extraArgs:
      external.url: {{ printf "https://%s%s" (requiredEnv "K8S_MONITORING_FQDN") $alertsPathPrefix | quote }}
      http.pathPrefix: {{ $alertsPathPrefix | quote }}
      notifier.blackhole: "true" # notifications are intentionally disabled
      remoteWrite.disablePathAppend: "true"
    podMetadata:
      labels:
        app.simcore.io/name: vmalert
        app.simcore.io/part-of: victoria-metrics-alert
    nodeSelector:
      node-role.kubernetes.io/ops: ""
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
    configReloaderResources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 128Mi

  ingress:
    host: {{ requiredEnv "K8S_MONITORING_FQDN" | quote }}
    path: {{ $alertsPathPrefix | quote }}
    basicAuthMiddleware: {{ .Values.sharedOps.traefik.basicAuthMiddlewareRef | quote }}
