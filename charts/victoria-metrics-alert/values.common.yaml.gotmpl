{{- $alertsPathPrefix := "/alerts" }}
{{- $datasourceProxyName := "vmalert-datasource-proxy" }}
{{- $datasourceProxyPort := 8427 }} # vmauth HTTP service

{{- $stackVmauthPort := requiredEnv "VICTORIA_METRICS_VMAUTH_PORT" }}

{{- $victoriaLogsPort := requiredEnv "VICTORIA_LOGS_HTTP_PORT" }}


{{- $stackNamespace := "victoria-metrics-k8s-stack" }}
{{- $traefikNamespace := requiredEnv "TRAEFIK_NAMESPACE" }}
{{- $traefikBasicAuthMiddlewareName := requiredEnv "TRAEFIK_BASIC_AUTH_MIDDLEWARE_NAME" }}

{{- $stackVmauthURL := printf "http://vmauth-vm-k8s-stack.%s.svc.cluster.local.:%s/%s" $stackNamespace $stackVmauthPort "metrics" }}


vmK8sStackVMAuthPort: {{ $stackVmauthPort }}
victoriaLogsPort: {{ $victoriaLogsPort }}
kubernetesApiServerPort: {{ requiredEnv "KUBERNETES_API_SERVER_PORT" }}
victoriaMetricsK8sStackNamespace: {{ $stackNamespace | quote }}

configReloaderPort: 8435 # hardcoded in victoria metrics operator

vmauth:
  name: {{ $datasourceProxyName }}
  upstreamVMAuthPort: {{ $stackVmauthPort }}
  spec:
    port: {{ $datasourceProxyPort | quote }} # vmauth HTTP service
    logLevel: {{ requiredEnv "VICTORIA_METRICS_LOG_LEVEL" }}
    useStrictSecurity: true
    podMetadata:
      labels:
        app.simcore.io/name: vmauth-vmalert-datasource-proxy
        app.simcore.io/part-of: victoria-metrics-alert
    nodeSelector:
      node-role.kubernetes.io/ops: ""
    resources:
      requests:
        cpu: 10m
        memory: 64Mi
      limits:
        cpu: 200m
        memory: 128Mi
    configReloaderResources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 64Mi
    unauthorizedUserAccessSpec:
      discover_backend_ips: true
      url_map:
        # vmalert sends Prometheus query API requests to its single datasource URL.
        - src_paths:
            - "/api/v1/query.*"
          url_prefix:
            - {{ printf "%s/metrics/select/prometheus/" $stackVmauthURL | quote }}
        # VictoriaLogs query APIs are routed to its server, preserving its /logs prefix.
        - src_paths:
            - "/select/logsql/.*"
          url_prefix:
            - {{ printf "http://%s.victoria-logs-single.svc.cluster.local.:%s/logs/" "victoria-logs-single-server" $victoriaLogsPort | quote }}

vmalert:
  name: victoria-metrics-alert
  spec:
    datasource:
      url: {{ printf "http://vmauth-%s:%d/" $datasourceProxyName $datasourceProxyPort }}
    remoteRead:
      url: {{ printf "%s/select/prometheus" $stackVmauthURL }}
    remoteWrite:
      url: {{ printf "%s/insert/prometheus" $stackVmauthURL }}
    evaluationInterval: 30s
    logLevel: {{ requiredEnv "VICTORIA_METRICS_LOG_LEVEL" }}
    port: "8080"
    selectAllByDefault: true
    useStrictSecurity: true
    extraArgs:
      external.url: {{ printf "https://%s%s" (requiredEnv "K8S_MONITORING_FQDN") $alertsPathPrefix | quote }}
      http.pathPrefix: {{ $alertsPathPrefix | quote }}
      notifier.blackhole: "true" # notifications are intentionally disabled
      remoteWrite.disablePathAppend: "true"
    podMetadata:
      labels:
        app.simcore.io/name: vmalert
        app.simcore.io/part-of: victoria-metrics-alert
    nodeSelector:
      node-role.kubernetes.io/ops: ""
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi
    configReloaderResources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 128Mi

  ingress:
    host: {{ requiredEnv "K8S_MONITORING_FQDN" | quote }}
    path: {{ $alertsPathPrefix | quote }}
    basicAuthMiddleware: {{ printf "%s-%s@kubernetescrd" $traefikNamespace $traefikBasicAuthMiddlewareName }}
