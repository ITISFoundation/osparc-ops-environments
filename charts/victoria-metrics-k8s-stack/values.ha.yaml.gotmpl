{{- $logLevel := requiredEnv "VICTORIA_METRICS_LOG_LEVEL" }}

vm-k8s-stack:
  # the single instance is replaced by the cluster below
  vmsingle:
    enabled: false
    ingress:
      enabled: false

  vmcluster:
    enabled: true
    spec:
      replicationFactor: 2 # to how many storage nodes the data is replicated
      retentionPeriod: {{ requiredEnv "VICTORIA_METRICS_METRICS_RETENTION_PERIOD" | quote }}
      vmstorage:
        replicaCount: 2
        disableSelfServiceScrape: true # do not scrape vm's own components
        logLevel: {{ $logLevel }}
        # enforce restricted PodSecurity on operator-managed containers
        useStrictSecurity: true
        port: "8482" # http port (metrics/api)
        vmInsertPort: "8400" # vminsert -> vmstorage ingestion RPC port
        vmSelectPort: "8401" # vmselect -> vmstorage query RPC port
        podMetadata:
          labels: # labels used by the network policies (templates/networkpolicies)
            app.simcore.io/name: vmstorage
            app.simcore.io/part-of: {{ .Release.Name }}
        nodeSelector:
          ops: "true"
        topologySpreadConstraints:
          - maxSkew: 1
            topologyKey: kubernetes.io/hostname
            whenUnsatisfiable: DoNotSchedule
            labelSelector:
              matchLabels:
                app.simcore.io/name: vmstorage
                app.simcore.io/part-of: {{ .Release.Name }}
        resources: # mandatory cpu+memory limits (see SECURITY.md)
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: "1"
            memory: 1Gi
        storage:
          volumeClaimTemplate:
            spec:
              resources:
                requests:
                  storage: 50Gi
      vmselect:
        replicaCount: 2
        port: "8481" # http port (serves reads)
        disableSelfServiceScrape: true # do not scrape vm's own components
        logLevel: {{ $logLevel }}
        # enforce restricted PodSecurity on operator-managed containers
        useStrictSecurity: true
        podMetadata:
          labels: # labels used by the network policies (templates/networkpolicies)
            app.simcore.io/name: vmselect
            app.simcore.io/part-of: {{ .Release.Name }}
        nodeSelector:
          ops: "true"
        resources: # mandatory cpu+memory limits (see SECURITY.md)
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            cpu: 500m
            memory: 512Mi
        storage:
          volumeClaimTemplate:
            spec:
              resources:
                requests:
                  storage: 2Gi
      vminsert:
        replicaCount: 2
        port: "8480" # http port (receives remote-write)
        disableSelfServiceScrape: true # do not scrape vm's own components
        logLevel: {{ $logLevel }}
        # enforce restricted PodSecurity on operator-managed containers
        useStrictSecurity: true
        podMetadata:
          labels: # labels used by the network policies (templates/networkpolicies)
            app.simcore.io/name: vminsert
            app.simcore.io/part-of: {{ .Release.Name }}
        nodeSelector:
          ops: "true"
        resources: # mandatory cpu+memory limits (see SECURITY.md)
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            cpu: 500m
            memory: 512Mi

  vmauth: # fronts the cluster (read + write) and takes over the ingress
    enabled: true
    spec:
      port: "8427"
      logLevel: {{ $logLevel }}
      disableSelfServiceScrape: true # do not scrape vm's own components
      # enforce restricted PodSecurity on operator-managed containers
      useStrictSecurity: true
      podMetadata:
        labels: # labels used by the network policies (templates/networkpolicies)
          app.simcore.io/name: vmauth
          app.simcore.io/part-of: {{ .Release.Name }}
      nodeSelector:
        ops: "true"
      resources: # mandatory cpu+memory limits (see SECURITY.md)
        requests:
          cpu: 10m
          memory: 64Mi
        limits:
          cpu: 200m
          memory: 128Mi
      configReloaderResources: # limits for config-reloader sidecar (see SECURITY.md)
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          cpu: 100m
          memory: 64Mi
    ingress:
      enabled: true
      ingressClassName: traefik
      hosts:
        - {{ requiredEnv "K8S_MONITORING_FQDN" }}
      path: /metrics
      pathType: Prefix
      annotations:
        traefik.ingress.kubernetes.io/router.tls: "true"
        traefik.ingress.kubernetes.io/router.entrypoints: websecure
        traefik.ingress.kubernetes.io/router.middlewares: >-
          traefik-basic-auth@kubernetescrd,
          {{ .Release.Namespace }}-metrics-strip-prefix@kubernetescrd
