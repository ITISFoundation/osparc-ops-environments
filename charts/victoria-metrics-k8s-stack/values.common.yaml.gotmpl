# https://github.com/VictoriaMetrics/helm-charts/blob/victoria-metrics-k8s-stack-0.82.0/charts/victoria-metrics-k8s-stack/values.yaml
{{- $logLevel := requiredEnv "VICTORIA_METRICS_LOG_LEVEL" }} # one of INFO, WARN, ERROR, FATAL, PANIC
{{- $httpPathPrefix := "/metrics" }}

kubernetesApiServerPort: {{ requiredEnv "KUBERNETES_API_SERVER_PORT" }}

vm-k8s-stack:
  fullnameOverride: vm-k8s-stack # by default names are long and redundant

  #
  # vmagent (scraping metrics)
  #
  vmagent: # scrapes the targets and writes to vmsingle
    enabled: true
    spec:
      extraArgs:
        remoteWrite.maxHourlySeries: "150000" # side-effect: enables a metric used in alerts
        remoteWrite.maxDailySeries: "300000" # side-effect: enables a metric used in alerts
      port: "8429"
      logLevel: {{ $logLevel }}
      # enforce restricted PodSecurity on operator-managed containers
      # (config-init, vmagent, config-reloader): runAsNonRoot, seccompProfile,
      # allowPrivilegeEscalation=false, capabilities.drop=[ALL]
      useStrictSecurity: true
      podMetadata:
        labels: # labels used by the network policies (templates/networkpolicies)
          app.simcore.io/name: vmagent
          app.simcore.io/part-of: {{ .Release.Name }}
      nodeSelector:
        node-role.kubernetes.io/ops: ""
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi
      configReloaderResources: # limits for config-init + config-reloader sidecars (see SECURITY.md)
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          cpu: 100m
          memory: 64Mi

  #
  # vmsingle
  #
  vmsingle: # stores metrics and serves them
    enabled: true
    spec:
      port: "8428"
      logLevel: {{ $logLevel }}
      retentionPeriod: {{ requiredEnv "VICTORIA_METRICS_METRICS_RETENTION_PERIOD" | quote }}
      # served under a path prefix on the ingress; makes VMUI links resolve correctly
      # https://docs.victoriametrics.com/#prefix-for-http-api-endpoints
      extraArgs:
        http.pathPrefix: {{ $httpPathPrefix | quote }}
        vmalert.proxyURL: "http://vmalert-vm-k8s-stack:8080" # expose vmalert API
      # enforce restricted PodSecurity on the vmsingle container:
      # runAsNonRoot, seccompProfile, allowPrivilegeEscalation=false,
      # capabilities.drop=[ALL]
      useStrictSecurity: true
      podMetadata:
        labels: # labels used by the network policies (templates/networkpolicies)
          app.simcore.io/name: vmsingle
          app.simcore.io/part-of: {{ .Release.Name }}
      nodeSelector:
        node-role.kubernetes.io/ops: ""
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          cpu: "1"
          memory: 1Gi
      storage:
        storageClassName: {{ requiredEnv "KUBERNETES_CRITICAL_STORAGE_CLASS_NAME" | quote }}
        resources:
          requests:
            storage: 50Gi
    ingress:
      enabled: true
      ingressClassName: traefik
      hosts:
        - {{ requiredEnv "K8S_MONITORING_FQDN" }}
      path: {{ $httpPathPrefix }}
      pathType: Prefix
      annotations:
        traefik.ingress.kubernetes.io/router.tls: "true"
        traefik.ingress.kubernetes.io/router.entrypoints: websecure
        traefik.ingress.kubernetes.io/router.middlewares: >-
          {{ requiredEnv "TRAEFIK_NAMESPACE" }}-{{ requiredEnv "TRAEFIK_BASIC_AUTH_MIDDLEWARE_NAME" }}@kubernetescrd

  #
  # prometheus-node-exporter
  #
  prometheus-node-exporter:  # exports node (server) metrics
    enabled: true
    fullnameOverride: node-exporter-vm-k8s-stack
    # it needs to run in a privileged namespace to scrape node metrics
    namespaceOverride: "{{ .Release.Namespace }}-privileged"
    containerSecurityContext: # harden the container (KSV-0001, KSV-0104)
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      seccompProfile:
        type: RuntimeDefault
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 0.5
        memory: 128Mi
    vmScrape:
      spec:
        namespaceSelector: # chart templates do not set it properly when namespace is overriden
          matchNames: ["{{ .Release.Namespace }}-privileged"]
    networkPolicy:
      enabled: true

  #
  # kube-state-metrics
  #
  kube-state-metrics: # cluster metrics about the state of the objects (pods, PVs, etc.)
    enabled: true
    fullnameOverride: kube-state-metrics-vm-k8s-stack
    nodeSelector:
      node-role.kubernetes.io/ops: ""
    resources:
      requests:
        cpu: 10m
        memory: 64Mi
      limits:
        cpu: 200m
        memory: 256Mi
    networkPolicy:
      enabled: true
      flavor: kubernetes # calico understands kubernetes network policy
      egress:
      - to:
        - ipBlock:
            cidr: 10.0.0.0/8
        - ipBlock:
            cidr: 172.16.0.0/12
        - ipBlock:
            cidr: 192.168.0.0/16
        ports:
        - protocol: TCP
          port: {{ requiredEnv "KUBERNETES_API_SERVER_PORT" }} # kube-state-metrics watches the kubernetes api server

  #
  # kubelet (scrape kubelet metrics)
  #
  kubelet: # container metrics (cpu / memory)
    enabled: true

  #
  # vmalert (alerting)
  #
  vmalert:
    enabled: true
    spec:
      port: "8080"
      logLevel: {{ $logLevel }}
      selectAllByDefault: true
      evaluationInterval: 30s
      useStrictSecurity: true
      extraArgs:
        notifier.blackhole: "true" # no notifications
        http.pathPrefix: "/"
      podMetadata:
        labels:
          app.simcore.io/name: vmalert
          app.simcore.io/part-of: {{ .Release.Name }}
      nodeSelector:
        node-role.kubernetes.io/ops: ""
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 0.5
          memory: 512Mi
      configReloaderResources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          cpu: 100m
          memory: 128Mi

  defaultRules: # rules for vmalert
    enabled: true
    rules: # per-rule overrides
      # stream aggregation is not configured, so vm_streamaggr_* metrics never
      # exist and these two alerts sit permanently in "nomatch"; disable them
      StreamAggrFlushTimeout:
        enabled: false
      StreamAggrDedupFlushTimeout:
        enabled: false
    # start with a few alerts. Add more with time
    groups:
      etcd:
        enabled: false
      general:
        enabled: true
      k8sContainerCpuLimits:
        enabled: false
      k8sContainerCpuRequests:
        enabled: false
      k8sContainerCpuUsageSecondsTotal:
        enabled: false
      k8sContainerMemoryLimits:
        enabled: false
      k8sContainerMemoryRequests:
        enabled: false
      k8sContainerMemoryRss:
        enabled: false
      k8sContainerMemoryCache:
        enabled: false
      k8sContainerMemoryWorkingSetBytes:
        enabled: false
      k8sContainerMemorySwap:
        enabled: false
      k8sPodOwner:
        enabled: false
      k8sContainerResource:
        enabled: false
      kubeApiserver:
        enabled: false
      kubeApiserverAvailability:
        enabled: false
      kubeApiserverBurnrate:
        enabled: false
      kubeApiserverHistogram:
        enabled: false
      kubeApiserverSlos:
        enabled: false
      kubelet:
        enabled: false
      kubePrometheusGeneral:
        enabled: false
      kubePrometheusNodeRecording:
        enabled: false
      kubernetesApps:
        enabled: false
      kubernetesResources:
        enabled: false
      kubernetesStorage:
        enabled: false
      kubernetesSystem:
        enabled: false
      kubernetesSystemKubelet:
        enabled: false
      kubernetesSystemApiserver:
        enabled: false
      kubernetesSystemControllerManager:
        enabled: false
      kubeScheduler:
        enabled: false
      kubernetesSystemScheduler:
        enabled: false
      kubeStateMetrics:
        enabled: false
      nodeNetwork:
        enabled: false
      node:
        enabled: false
      # vm* groups stay enabled where the component runs (vmHealth, vmagent,
      # vmsingle, vmoperator). vmcluster is off here and turned on in the HA overlay.
      vmcluster:
        enabled: false
      alertmanager:
        enabled: false

  victoria-metrics-operator:
    enabled: false # operator is deployed separately
  vmcluster:
    enabled: false
  alertmanager:
    enabled: false
  grafana:
    enabled: false
  defaultDashboards:
    enabled: false
  kubeApiServer:
    enabled: false
  kubeControllerManager:
    enabled: false
  coreDns:
    enabled: false
  kubeEtcd:
    enabled: false
  kubeScheduler:
    enabled: false
