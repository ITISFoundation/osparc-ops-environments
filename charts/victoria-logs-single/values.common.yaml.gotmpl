# https://github.com/VictoriaMetrics/helm-charts/blob/victoria-logs-single-0.13.8/charts/victoria-logs-single/values.yaml
{{- $ingressHttpPathPrefix := "/logs" }}
{{- $vectorMetricsPort := 9090 }}
{{- $vmSinglePort := requiredEnv "VICTORIA_LOGS_HTTP_PORT" }}
{{- $basicAuthMiddleware := printf "%s-%s@kubernetescrd" (requiredEnv "TRAEFIK_NAMESPACE") (requiredEnv "TRAEFIK_BASIC_AUTH_MIDDLEWARE_NAME") }}

ingressHost: {{ requiredEnv "K8S_MONITORING_FQDN" }}

kubernetesApiServerPort: {{ requiredEnv "KUBERNETES_API_SERVER_PORT" }}
vectorMetricsPort: {{ $vectorMetricsPort }} # easy to use in templates (instead of values extracting)
vmSinglePort: {{ $vmSinglePort }} # easy to use in templates (instead of values extracting)

grafanaLogsDatasourceType: victoriametrics-logs-datasource
grafanaLogsDatasourceUid: victoria-logs

victoria-logs-single:
  global:
    image:
      registry: quay.io # common registry we already use for other workloads
    cluster:
      dnsDomain: cluster.local.

  # scrape logs and send them to VictoriaLogs
  vector:
    enabled: true

    # Distroless image lacks journalctl, which Vector's `journald` source shells out to.
    # https://github.com/vectordotdev/vector/issues/19325#issuecomment-2816718363
    image:
      base: debian

    persistence: # done to keep logs from disk buffer and survive vector restarts
      hostPath:
        enabled: true
        path: /var/lib/vector

    customConfig: # extends default vector config (only includes kubernetes logs)
      sources:
        # Host systemd journal (kubelet, containerd, kernel, ...).
        # Assumes persistent journald: Storage=persistent in journald.conf
        # so that /var/log/journal exists on every node. Verify before rollout.
        journald:
          type: journald
          journal_directory: /var/log/journal
          current_boot_only: true

      transforms:
        journald_parser: # Trim journald events to a low-cardinality, useful field set.
          type: remap
          inputs: [journald]
          source: |
            # PRIORITY arrives as string in Vector's journald source.
            level = to_syslog_level(to_int(.PRIORITY) ?? 6) ?? "unknown"

            # `unit` is a VictoriaLogs stream field, so it must stay low-cardinality:
            # every distinct value creates a new log stream, and too many streams
            # degrade ingestion/query performance and inflate disk usage.
            # systemd uses per-instance unit names for transient units (container
            # scopes, per-pod slices, user managers, run-* transients) which are
            # effectively unbounded. We collapse each of those families into a single
            # stable label while leaving real services (kubelet.service, ...) intact.
            unit = string(._SYSTEMD_UNIT) ?? string(._TRANSPORT) ?? "unknown"
            if ends_with(unit, ".scope") {
              # cri-containerd-<hash>.scope, session-c123.scope, machine-….scope, ...
              unit = "transient.scope"
            } else if starts_with(unit, "kubepods") {
              # kubepods-burstable-pod<UID>.slice lifecycle msgs -> bound the per-pod UID
              unit = "kubepods.slice"
            } else if starts_with(unit, "user@") {
              unit = "user.service"
            } else if starts_with(unit, "run-") {
              unit = "transient.service"
            }

            # see field explanations
            # https://www.freedesktop.org/software/systemd/man/latest/systemd.journal-fields.html
            . = {
              "_msg":              .message,
              "timestamp":         .timestamp,
              "host":              .host,
              "unit":              unit,
              "syslog_identifier": .SYSLOG_IDENTIFIER,
              "transport":         ._TRANSPORT,
              "level":             level,
              "source_type":       .source_type,
            }

      sinks:
        vlogs_journald: # endpoint is configured automatically by the victoria-logs chart template
          type: elasticsearch
          inputs: [journald_parser]
          mode: bulk
          api_version: v8
          compression: gzip
          healthcheck:
            enabled: false
          request:
            headers:
              VL-Time-Field: timestamp
              VL-Stream-Fields: source_type,host,unit
              VL-Msg-Field: _msg
              AccountID: "0"
              ProjectID: "0"
        vlogs:
          # when endpoint is not available keep logs in disk buffer to avoid losing them
          # once endpoint is back, logs will be sent from buffer to endpoint
          # https://vector.dev/docs/architecture/buffering-model/#disk-buffers
          buffer:
            type: disk
            max_size: 1073741824  # 1Gi
            when_full: drop_newest
          request:
            # https://docs.victoriametrics.com/victorialogs/data-ingestion/#http-headers
            headers:
              # overwrite default headers to include source_type and exclude less useful stream
              VL-Stream-Fields: source_type,kubernetes.pod_name,kubernetes.container_name,kubernetes.pod_namespace
              # remove some noisy fields
              # (see all fields at https://vector.dev/docs/reference/configuration/sources/kubernetes_logs/#line-fields)
              VL-Ignore-Fields: >-
                kubernetes.node_labels.*,
                kubernetes.pod_labels.*,
                kubernetes.pod_annotations.*,
                kubernetes.namespace_labels.*,
                kubernetes.pod_ip,
                kubernetes.pod_ips,
                kubernetes.container_image_id,
                file

    # /proc and /sys are not needed for kubernetes_logs source (KSV-0121)
    defaultVolumes:
      - name: var-log
        hostPath:
          path: "/var/log/"
      - name: var-lib
        hostPath:
          path: "/var/lib/"
    defaultVolumeMounts:
      - name: var-log
        mountPath: "/var/log/"
        readOnly: true
      - name: var-lib
        mountPath: "/var/lib"
        readOnly: true

    containerPorts:
      - name: prom-exporter
        containerPort: {{ $vectorMetricsPort }} # define explicitly. do not rely on chart defaults as they may change
        protocol: TCP

    podLabels: # use in network policy. don't rely on chart labels as they can change
      app.simcore.io/name: victoria-logs-single-vector
      app.simcore.io/part-of: {{ .Release.Name }}

    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: "1"
        memory: 512Mi

    podMonitor:
      enabled: true

    # vector needs write access to hostPath /var/lib/vector for checkpoints,
    # running as non-root is not feasible: https://github.com/vectordotdev/vector/issues/1599
    # also see https://github.com/vectordotdev/helm-charts/issues/266
    podSecurityContext:
      seccompProfile:
        type: RuntimeDefault

    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities:
        drop:
          - ALL

  # victoria-logs server. store and serve logs
  server:
    replicaCount: 1

    # take over the control of naming so we can reuse it in our templates
    # robustly (e.g. in datasource url)
    fullnameOverride: {{ .Release.Name }}-server

    # https://docs.victoriametrics.com/victorialogs/#retention
    retentionPeriod: 30d
    # https://docs.victoriametrics.com/victorialogs/#percentage-based-disk-space-limit
    retentionDiskSpaceUsage: 95

    extraArgs:
      http.pathPrefix: {{ $ingressHttpPathPrefix | quote }}

    persistentVolume:
      enabled: true
      storageClassName: {{ requiredEnv "KUBERNETES_CRITICAL_STORAGE_CLASS_NAME" | quote }}
      size: 100Gi

    ingress:
      enabled: true
      annotations:
          namespace: "{{ .Release.Namespace }}"
          traefik.ingress.kubernetes.io/router.tls: "true"
          traefik.ingress.kubernetes.io/router.entrypoints: websecure
          traefik.ingress.kubernetes.io/router.middlewares: {{ $basicAuthMiddleware }}
      hosts:
        - name: {{ requiredEnv "K8S_MONITORING_FQDN" }}
          path:
            - {{ $ingressHttpPathPrefix | quote }}
          pathType: Prefix

    vmServiceScrape:
      enabled: false # added in ./templates since vm-single templates don't set correct metrics path

    http:
      - name: http
        primary: true
        value: :{{ $vmSinglePort }} # define explicitly. do not rely on chart defaults as they may change

    podLabels: # use in network policy. don't rely on chart labels as they can change
      app.simcore.io/name: victoria-logs-single
      app.simcore.io/part-of: {{ .Release.Name }}

    nodeSelector:
      node-role.kubernetes.io/ops: ""

    # Schedule pods on different nodes if possible (HA)
    # https://stackoverflow.com/a/64958458/12124525
    topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: "kubernetes.io/hostname"
        whenUnsatisfiable: DoNotSchedule
        # hardcoded due to https://github.com/VictoriaMetrics/helm-charts/issues/2219
        labelSelector:
          matchLabels:
            app: server
            app.kubernetes.io/instance: victoria-logs
            app.kubernetes.io/name: victoria-logs-single

    securityContext:
      seccompProfile:
        type: RuntimeDefault

    resources:
      limits:
        cpu: "2"
        memory: 2Gi
      requests:
        cpu: "500m"
        memory: 512Mi

  dashboards:
    enabled: true
    labels:
      grafana_dashboard: "true_string"
    annotations:
      dashboard_folder: "OPS Apps"
