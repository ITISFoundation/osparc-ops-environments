{{- $grafanaBasicAuthSecretName := "grafana-basic-auth" }}
# https://github.com/grafana-community/helm-charts/blob/grafana-12.4.4/charts/grafana/values.yaml
networkPolicy:
  enabled: true
  allowExternal: true
  ingress: true
  egress:
    enabled: true
    ports:
      - port: {{ requiredEnv "VICTORIA_METRICS_VMAUTH_PORT" | int }}
      - port: 443 # install plugins from outside
      - port: {{ requiredEnv "KUBERNETES_API_SERVER_PORT" | int }}

persistence:
  enabled: true
  # statefulset is not properly supported — state is not synchronized between replicas
  type: pvc
  size: 1Gi
  storageClassName: {{ requiredEnv "KUBERNETES_DEFAULT_STORAGE_CLASS_NAME" | quote }}

deploymentStrategy:
  type: Recreate # needed because of PVC. At most 1 pod shall use PVC at a time

resources:
  limits:
    cpu: 1
    memory: 256Mi
  requests:
    cpu: 0.1
    memory: 128Mi

securityContext:
  runAsNonRoot: true
  runAsUser: 472
  runAsGroup: 472
  fsGroup: 472
  seccompProfile:
    type: RuntimeDefault

containerSecurityContext:
  readOnlyRootFilesystem: true
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL
  seccompProfile:
    type: RuntimeDefault

nodeSelector:
  node-role.kubernetes.io/ops: ""

ingress:
  enabled: true
  annotations:
    traefik.ingress.kubernetes.io/router.tls: "true"
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
  hosts:
    - {{ requiredEnv "K8S_MONITORING_FQDN" }}
  path: /grafana

admin:
  existingSecret: {{ $grafanaBasicAuthSecretName }}
  userKey: admin-user
  passwordKey: admin-password

assertNoLeakedSecrets: true

# writable /tmp required because containerSecurityContext.readOnlyRootFilesystem is true
# see https://github.com/grafana-community/helm-charts/issues/729 for more
extraVolumeMounts:
  - name: tmp
    mountPath: /tmp
extraVolumes:
  - name: tmp
    emptyDir: {}

extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: {{ $grafanaBasicAuthSecretName }}
      labels:
        app.kubernetes.io/app: grafana
        app.kubernetes.io/instance: {{ .Release.Name }}
    type: Opaque
    stringData:
      admin-user: {{ requiredEnv "SERVICES_USER" }}
      admin-password: {{ requiredEnv "SERVICES_PASSWORD" }}

initChownData:
  # runs as root — does not align with restricted pod security standard
  enabled: false

grafana.ini:
  server:
    # https://stackoverflow.com/a/69766805/12124525
    # https://github.com/grafana/helm-charts/blob/main/charts/grafana/README.md#example-ingress-with-path
    root_url: https://{{ requiredEnv "K8S_MONITORING_FQDN" }}/grafana
    serve_from_sub_path: true
  # https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/#log
  log:
    # console mode avoids writes to /var/log/grafana (required for readOnlyRootFilesystem)
    # see https://github.com/grafana-community/helm-charts/issues/729 for more
    mode: console
    # https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/#level
    level: {{ requiredEnv "GRAFANA_LOG_LEVEL" | lower }}

sidecar:
  # https://github.com/grafana-community/helm-charts/blob/grafana-12.4.4/charts/grafana/values.yaml#L1020
  logLevel: {{ requiredEnv "GRAFANA_LOG_LEVEL" }}
  # prefixes the filename with the namespace + ConfigMap
  # avoid potential collisions if configmap has the same key
  enableUniqueFilenames: true
  resources:
    limits:
      cpu: 0.5
      memory: 256Mi
    requests:
      cpu: 0.1
      memory: 32Mi
  securityContext:
    readOnlyRootFilesystem: true
    allowPrivilegeEscalation: false
    capabilities:
      drop:
        - ALL
    seccompProfile:
      type: RuntimeDefault
  dashboards: # https://grafana.com/docs/grafana/v12.4/administration/provisioning/#dashboards
    enabled: true
    # configmap-only avoids cluster-wide secret read access in the ClusterRole
    resource: configmap
    label: grafana_dashboard
    labelValue: true_string
    logLevel: {{ requiredEnv "GRAFANA_LOG_LEVEL" }}
    searchNamespace: ALL
    folderAnnotation: "dashboard_folder"
    provider:
      # nested folders are not supported https://github.com/grafana/grafana/issues/107158
      # until this PR is released https://github.com/grafana/grafana/pull/119852
      foldersFromFilesStructure: true
      # users can edit IMPORTED dashboards in the UI but cannot save it.
      # instead grafana offers to export json file (which then can be added
      # to code and deployed via CI). It does not relate to dashboards
      # manually created in the UI
      allowUiUpdates: false
      # imported dashboards still cannot be deleted via the UI. Delete related config map
      # to actually delete imported dashboard https://github.com/grafana/grafana/issues/41085
      disableDelete: false
  datasources: # https://grafana.com/docs/grafana/v12.4/administration/provisioning/#data-sources
    enabled: true
    # monitor only secrets
    resource: secret
    label: grafana_datasource
    labelValue: true_string
    logLevel: {{ requiredEnv "GRAFANA_LOG_LEVEL" }}
    searchNamespace: ALL

# shadows /usr/share/grafana/data/plugins-bundled with an emptyDir so bundled
# plugins (e.g. elasticsearch) can be updated on the read-only root filesystem
# see https://github.com/grafana-community/helm-charts/issues/729 for more
shadowBundledPlugins: true

plugins:
  - victoriametrics-metrics-datasource
