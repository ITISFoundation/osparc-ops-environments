receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317  # Default endpoint for OTLP over gRPC
      http:
        endpoint: 0.0.0.0:4318 # Default endpoint for OTLP over HTTP
extensions:
  basicauth/kubernetes:
    client_auth:
      username: ${SERVICES_USER}
      password: ${SERVICES_PASSWORD}
exporters:
  # disabled: tracing moved to Kubernetes VictoriaTraces
  # otlp:
  #   endpoint: http://tempo:4317
  #   tls:
  #     insecure: true
  otlphttp/kubernetes:
    traces_endpoint: ${K8S_MONITORING_PRIVATE_ENDPOINT}/traces/insert/opentelemetry/v1/traces
    auth:
      authenticator: basicauth/kubernetes
{% if env("S3_BUCKET_NAME_AI_TRACES", "") and env("AWS_ACCESS_KEY_ID", "") and env("AWS_SECRET_ACCESS_KEY", "") %}
  awss3/s4l_ai_archive:
    marshaler: otlp_json
    s3uploader:
      region: us-east-1
      s3_bucket: ${S3_BUCKET_NAME_AI_TRACES}
      s3_prefix: ""
      s3_partition_format: "year=%Y/month=%m/day=%d/hour=%H"
      s3_partition_timezone: UTC
      compression: none
      retry_max_attempts: 99
      retry_max_backoff: 60s
    sending_queue:
      enabled: true
      num_consumers: 10
      queue_size: 1000
      wait_for_result: false
    timeout: 30s
{% endif %}
service:
  extensions: [basicauth/kubernetes]
  pipelines:
    # disabled: legacy Tempo pipeline, see disabled otlp exporter above
    # traces:
    #   receivers: [otlp]
    #   exporters: [otlp]
    #   processors: [batch,filter/drop_healthcheck]
    traces/kubernetes:
      receivers: [otlp]
      exporters: [otlphttp/kubernetes]
      processors: [batch,filter/drop_healthcheck,resource/swarm_cluster]
{% if env("S3_BUCKET_NAME_AI_TRACES", "") and env("AWS_ACCESS_KEY_ID", "") and env("AWS_SECRET_ACCESS_KEY", "") %}
    # archive the s4l-ai (vendors chatbot) chat-completions traces to AWS S3
    traces/s4l_ai_archive:
      receivers: [otlp]
      exporters: [awss3/s4l_ai_archive]
      processors: [filter/keep_s4l_ai_chat_completions,batch]
{% endif %}
  telemetry:
    metrics: # https://opentelemetry.io/docs/collector/internal-telemetry/#prometheus-endpoint-for-internal-metrics
      readers:
        - pull:
            exporter:
              prometheus:
                host: '0.0.0.0'
                port: 8888

    logs:
      level: ${TRACING_OPENTELEMETRY_COLLECTOR_SERVICE_TELEMETRY_LOG_LEVEL}
processors:
  batch:
    timeout: 5s
    send_batch_size: ${TRACING_OPENTELEMETRY_COLLECTOR_BATCH_SIZE}
  filter/drop_healthcheck:
    error_mode: ignore
    traces:
      span:
        - attributes["http.route"] == "/health"
        - attributes["http.target"] == "/socket.io/"
        - attributes["url.path"] == "/socket.io/"
        - attributes["server.address"] == "/var/run/docker.sock"
        - IsMatch(attributes["server.address"], "^monitoring..*")
        - attributes["net.peer.name"] == "/var/run/docker.sock"
        - attributes["http.route"] == "healthcheck_readiness_probe"
        - attributes["http.route"] == "healthcheck_liveness_probe"
        - attributes["http.target"] == "/metrics" and IsMatch(attributes["http.user_agent"], ".*Prometheus.*") == true
        - attributes["db.statement"] == "PING" and attributes["db.system"] == "redis"
        - IsMatch(attributes["db.statement"], "^SCAN[\\s?]*$") and attributes["db.system"] == "redis"
  resource/swarm_cluster:
    attributes:
      - key: cluster
        value: docker_swarm
        action: upsert
{% if env("S3_BUCKET_NAME_AI_TRACES", "") and env("AWS_ACCESS_KEY_ID", "") and env("AWS_SECRET_ACCESS_KEY", "") %}
  # keep only the vendors chatbot (service.name=s4l-ai) server spans of
  # /v1/chat/completions
  filter/keep_s4l_ai_chat_completions:
    error_mode: ignore
    traces:
      span:
        - 'not (resource.attributes["service.name"] == "s4l-ai" and IsMatch(attributes["http.route"], "^/v1/chat/completions"))'
{% endif %}
